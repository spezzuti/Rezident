<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ (API 31) platform splash screen. The OS shows this on every
         cold start using the *android:*-prefixed splash attributes, so we set
         them explicitly here to guarantee the near-black brand background and
         the green R icon (not the default white flash + stock launcher icon). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
